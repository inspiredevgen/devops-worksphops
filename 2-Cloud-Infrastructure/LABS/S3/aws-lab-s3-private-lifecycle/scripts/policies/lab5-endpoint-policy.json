{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LabBucketOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME",
        "arn:aws:s3:::BUCKET_NAME/*"
      ]
    },
    {
      "Sid": "AmazonLinux2023PackageRepositories",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::al2023-repos-us-west-1-de612dc2/*"
    }
  ]
}
