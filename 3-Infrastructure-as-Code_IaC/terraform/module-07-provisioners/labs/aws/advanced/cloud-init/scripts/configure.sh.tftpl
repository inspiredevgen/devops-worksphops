#!/bin/bash
# EN: Part 2 of the multi-part document: runs in cloud-init's FINAL stage,
#     i.e. AFTER the packages from part 1 are installed.
# FR: Partie 2 du document multi-parties : s'exécute à l'étape FINALE de
#     cloud-init, donc APRÈS l'installation des paquets de la partie 1.
set -euxo pipefail

TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
AZ=$(curl -s -H "X-aws-ec2-metadata-token: $${TOKEN}" http://169.254.169.254/latest/meta-data/placement/availability-zone)

sed "s/__AZ__/$${AZ}/" /opt/tf-lab/index.html > /usr/share/nginx/html/index.html
echo "ok" > /usr/share/nginx/html/healthz
echo "${environment} configured at $(date -u +%FT%TZ)" >> /var/log/tf-lab-bootstrap.log
