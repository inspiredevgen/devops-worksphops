# EN: Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.
# FR: Copiez vers terraform.tfvars et modifiez. terraform.tfvars est ignoré par git.

aws_region = "ca-central-1"

# EN: Your admin IAM user ARN (from `aws sts get-caller-identity`).
# FR: L'ARN de votre utilisateur IAM admin (via `aws sts get-caller-identity`).
trusted_principal_arns = ["arn:aws:iam::123456789012:user/tf-admin"]

max_session_hours = 1
