# Generated by Terraform - do not edit / Généré par Terraform - ne pas modifier
app:
  name: ${name}
  environment: ${environment}
  tier: ${tier}
%{ if is_critical ~}
  on_call: required
  backups: hourly
%{ else ~}
  on_call: business-hours
  backups: daily
%{ endif ~}
network:
  vpc_cidr: ${vpc_cidr}
  subnets:
%{ for subnet_name, cidr in subnets ~}
    ${subnet_name}: ${cidr}
%{ endfor ~}
  ports:
%{ for p in ports ~}
    - ${p}
%{ endfor ~}
settings:
%{ for key, value in settings ~}
  ${key}: "${value}"
%{ endfor ~}
