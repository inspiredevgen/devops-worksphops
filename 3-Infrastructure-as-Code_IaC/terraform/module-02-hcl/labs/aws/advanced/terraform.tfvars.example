# EN: Copy to terraform.tfvars. Omitted optional attributes get their defaults.
# FR: Copiez vers terraform.tfvars. Les attributs optionnels omis prennent leur valeur par défaut.

app = {
  name        = "My Shop API!"
  environment = "dev"
  owner       = "platform-team"
  ports       = [443, 8443]
  settings = {
    log_level = "debug" # EN: overrides defaults.yaml / FR: surcharge defaults.yaml
  }
}

vpc_cidr = "10.42.0.0/16"
