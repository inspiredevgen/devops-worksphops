# =============================================================================
# EN: Terraform writes the Ansible inventory (and, in bastion mode, the tunnel script).
# FR : Terraform écrit l'inventaire Ansible (et, en mode bastion, le script de tunnels).
# =============================================================================

locals {
  roles = toset([for h in values(var.hosts) : h.role])
  envs  = toset([for h in values(var.hosts) : h.environment])
  oses  = toset([for h in values(var.hosts) : h.os])
  port  = { for i, n in local.names : n => var.tunnel_base_port + i }

  hostvars = {
    for name, h in var.hosts : name => merge(
      local.ssh ? {
        ansible_host = azurerm_public_ip.host[name].ip_address
        } : {
        ansible_host = "127.0.0.1" # EN: through the local tunnel / FR : par le tunnel local
        ansible_port = local.port[name]
      },
      {
        ansible_user     = "azureuser"
        cloud_vm_name    = azurerm_linux_virtual_machine.host[name].name
        cloud_private_ip = azurerm_network_interface.host[name].private_ip_address
      }
    )
  }

  inventory = {
    all = {
      vars = { cloud = "azure" }
      children = merge(
        { for r in local.roles : r => { hosts = { for n, h in var.hosts : n => null if h.role == r } } },
        { for e in local.envs : e => { hosts = { for n, h in var.hosts : n => null if h.environment == e } } },
        { for o in local.oses : "os_${o}" => { hosts = { for n, h in var.hosts : n => null if h.os == o } } },
        { cloud_hosts = { hosts = local.hostvars } }
      )
    }
  }
}

resource "local_file" "inventory" {
  count = var.inventory_path == null ? 0 : 1

  filename        = var.inventory_path
  file_permission = "0644"
  content         = "# EN: Generated by lab-hosts/azure (Terraform). Do not edit: re-apply instead.\n# FR : Généré par lab-hosts/azure (Terraform). Ne pas modifier : réappliquer.\n${yamlencode(local.inventory)}"
}

# EN: bastion mode: one background tunnel per VM, localhost:<port> → VM:22. Stop them with: kill %1 %2 … or close the shell.
# FR : mode bastion : un tunnel en arrière-plan par VM, localhost:<port> → VM:22. Arrêtez-les avec kill, ou fermez le shell.
resource "local_file" "tunnels" {
  count = local.ssh ? 0 : 1

  filename        = var.inventory_path == null ? "${path.root}/bastion-tunnels.sh" : "${dirname(var.inventory_path)}/bastion-tunnels.sh"
  file_permission = "0755"
  content = join("\n", concat(
    [
      "#!/usr/bin/env bash",
      "# Generated by lab-hosts/azure. Usage: ./bastion-tunnels.sh   (keep this terminal open / gardez ce terminal ouvert)",
      "set -euo pipefail",
      "trap 'kill $(jobs -p) 2>/dev/null' EXIT",
    ],
    [for n in local.names : "az network bastion tunnel --name ${azurerm_bastion_host.lab[0].name} --resource-group ${azurerm_resource_group.lab.name} --target-resource-id ${azurerm_linux_virtual_machine.host[n].id} --resource-port 22 --port ${local.port[n]} & echo \"${n} → 127.0.0.1:${local.port[n]}\""],
    ["wait", ""]
  ))
}
