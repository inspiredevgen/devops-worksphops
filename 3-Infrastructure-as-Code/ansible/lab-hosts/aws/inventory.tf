# =============================================================================
# EN: Terraform writes the Ansible inventory: the hand-off between the two tools (Module 7 goes deeper).
# FR : Terraform écrit l'inventaire Ansible : le passage de relais entre les deux outils (approfondi au module 7).
# =============================================================================

locals {
  # EN: ProxyCommand rather than ProxyJump (-J): the inner ssh to the jump host gets the SAME host-key policy
  #     and known_hosts file as the outer one; with -J it would fall back to your defaults and may prompt.
  # FR : ProxyCommand plutôt que ProxyJump (-J) : le ssh interne vers le rebond reçoit la MÊME politique de clés
  #     d'hôte et le même known_hosts que le ssh externe ; avec -J il reprendrait vos réglages par défaut.
  proxy_args = local.proxyjump ? "-o ProxyCommand=\"ssh -W %h:%p -q -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=~/.ssh/known_hosts_ansible_lab ubuntu@${aws_instance.jump[0].public_ip}\"" : ""

  roles = toset([for h in values(var.hosts) : h.role])
  envs  = toset([for h in values(var.hosts) : h.environment])
  oses  = toset([for h in values(var.hosts) : h.os])

  hostvars = {
    for name, h in var.hosts : name => merge(
      local.uses_key ? {
        # EN: proxyjump: the PRIVATE IP, reached through the jump host (see all.vars).
        # FR : proxyjump : l'IP PRIVÉE, jointe par l'hôte de rebond (voir all.vars).
        ansible_host = local.proxyjump ? aws_instance.host[name].private_ip : aws_instance.host[name].public_ip
        ansible_user = local.login_user[h.os]
        } : {
        ansible_host       = aws_instance.host[name].id # EN: SSM targets the instance ID / FR : SSM cible l'ID d'instance
        ansible_connection = "amazon.aws.aws_ssm"
      },
      {
        cloud_instance_id = aws_instance.host[name].id
        cloud_private_ip  = aws_instance.host[name].private_ip
      }
    )
  }

  inventory = {
    all = {
      vars = merge(
        { cloud = "aws" },
        local.ssm ? {
          ansible_aws_ssm_bucket_name = aws_s3_bucket.ssm[0].bucket
          ansible_aws_ssm_region      = var.aws_region
        } : {},
        local.proxyjump ? { ansible_ssh_common_args = local.proxy_args } : {}
      )
      children = merge(
        { for r in local.roles : r => { hosts = { for n, h in var.hosts : n => null if h.role == r } } },
        { for e in local.envs : e => { hosts = { for n, h in var.hosts : n => null if h.environment == e } } },
        { for o in local.oses : "os_${o}" => { hosts = { for n, h in var.hosts : n => null if h.os == o } } },
        { cloud_hosts = { hosts = local.hostvars } }
      )
    }
  }
}

resource "local_file" "inventory" {
  count = var.inventory_path == null ? 0 : 1

  filename        = var.inventory_path
  file_permission = "0644"
  content         = "# EN: Generated by lab-hosts/aws (Terraform). Do not edit: re-apply instead.\n# FR : Généré par lab-hosts/aws (Terraform). Ne pas modifier : réappliquer.\n${yamlencode(local.inventory)}"
}
