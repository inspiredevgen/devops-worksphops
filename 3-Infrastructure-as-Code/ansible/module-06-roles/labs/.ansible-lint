---
# =============================================================================
# EN: ansible-lint settings for the Module 6 labs. Each exception says WHY: an unexplained skip is a smell.
#     Lint the collection consumer with the source on the path:
#       ANSIBLE_COLLECTIONS_PATH=$PWD/shared/advanced ansible-lint --profile production .
# FR : Réglages d'ansible-lint pour les labs du module 6. Chaque exception dit POURQUOI.
# =============================================================================
exclude_paths:
  # EN: overlays copied over the collection for 1.1.0 / 2.0.0, not standalone roles; check-release.sh lints them after.
  # FR : surcouches copiées sur la collection pour 1.1.0 / 2.0.0 ; check-release.sh les vérifie après application.
  - shared/advanced/upgrades/
  # EN: generated by antsibull-changelog / FR : généré par antsibull-changelog
  - shared/advanced/ansible_collections/inspiredevgen/platform/changelogs/changelog.yaml

warn_list:
  # EN: the rule's list of "supported" versions lags behind ansible-core 2.21 (the version this course tests on).
  # FR : la liste des versions « prises en charge » de la règle est en retard sur ansible-core 2.21.
  - meta-runtime[unsupported-version]
