# EN: Terraform working files — never commit these.
# FR: Fichiers de travail Terraform — ne jamais les versionner.

# Local provider/module cache / Cache local des providers et modules
**/.terraform/*

# State files contain secrets! / Les fichiers d'état contiennent des secrets !
*.tfstate
*.tfstate.*

# Crash logs / Journaux de plantage
crash.log
crash.*.log

# Variable files with real values / Fichiers de variables avec vraies valeurs
*.tfvars
*.tfvars.json
!*.tfvars.example
# EN: Per-environment files hold NO secrets and are meant to be reviewed in PRs.
# FR: Les fichiers par environnement ne contiennent AUCUN secret et sont révisés en PR.
!**/environments/*.tfvars

# Saved plans / Plans enregistrés
*.tfplan
tfplan

# Local overrides / Surcharges locales
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config / Configuration CLI
.terraformrc
terraform.rc

# NOTE: DO commit .terraform.lock.hcl / NOTE : versionnez .terraform.lock.hcl

# EN: Files generated by labs (Module 7) / FR: Fichiers générés par les labs (module 7)
**/inventory.ini
**/audit.log
**/manifest.json

# Module 9: tflint plugin cache / cache des plugins tflint
**/.tflint.d/

# Module 10: plan exports for policy checks (fixtures are named *-plan-*.json and stay tracked)
# Module 10 : exports de plan pour les politiques (les jeux de test *-plan-*.json restent suivis)
plan.json
